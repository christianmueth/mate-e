generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

model User {
  id            String         @id @default(cuid())
  clerkUserId   String         @unique
  dailyGoal     Int            @default(50)
  lastStudyDate DateTime?
  studyStreak   Int            @default(0)
  xp            Int            @default(0)
  xpToday       Int            @default(0)
  xpTodayDate   DateTime?
  plan          SubscriptionPlan @default(FREE)
  stripeCustomerId String?     @unique
  stripeSubscriptionId String? @unique
  stripePriceId String?
  stripeSubscriptionStatus String?
  stripeCurrentPeriodEnd DateTime?
  decks         Deck[]
  reasoningRuns ReasoningRun[]
  studentState  StudentState?
  calendarShares CalendarShare[]
  calendarEvents CalendarEvent[]
  planTasks     PlanTask[]
  calendarAvailability CalendarAvailability?
  calendarProposals CalendarProposal[]
}

model CalendarShare {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  title     String
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model CalendarEvent {
  id              String   @id @default(cuid())
  userId          String
  title           String
  description     String?
  startsAt        DateTime
  endsAt          DateTime
  timezone        String   @default("UTC")
  recurrence      String   @default("NONE")
  recurrenceUntil DateTime?
  reminderMinutes Int?
  reminderEmail   String?
  reminderSentAt  DateTime?
  taskId          String?
  proposalId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task            PlanTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  proposal        CalendarProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([userId, startsAt])
  @@index([reminderSentAt, startsAt])
  @@index([taskId])
  @@index([proposalId])
}

model CalendarAvailability {
  id              String   @id @default(cuid())
  userId          String   @unique
  workdays        Json
  startMinutes    Int      @default(540)
  endMinutes      Int      @default(1020)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CalendarProposal {
  id          String   @id @default(cuid())
  userId      String
  taskId      String?
  title       String
  deadline    DateTime
  totalMinutes Int
  items       Json
  status      String   @default("PENDING")
  appliedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        PlanTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  events      CalendarEvent[]

  @@index([userId, status, createdAt])
  @@index([taskId])
}

model PlanTask {
  id          String          @id @default(cuid())
  userId      String
  title       String
  description String?
  status      String          @default("TODO")
  dueAt       DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events      CalendarEvent[]
  proposals   CalendarProposal[]

  @@index([userId, dueAt])
}

model Deck {
  id            String         @id @default(cuid())
  userId        String
  title         String
  source        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  cards         Card[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reasoningRuns ReasoningRun[]
}

model Card {
  id              String    @id @default(cuid())
  deckId          String
  question        String
  answer          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastReviewedAt  DateTime?
  srsDueAt        DateTime  @default(now())
  srsEase         Float     @default(2.5)
  srsIntervalDays Int       @default(0)
  srsLapses       Int       @default(0)
  srsReps         Int       @default(0)
  deck            Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
}

model ReasoningRun {
  id                            String               @id @default(cuid())
  userId                        String?
  deckId                        String?
  mode                          String
  origin                        String?
  title                         String?
  prompt                        String?
  finalAnswer                   String?
  reasoning                     String?
  confidence                    Float?
  trajectoryScore               Float?
  searchDepth                   Int                  @default(0)
  beamWidth                     Int?
  candidatesGenerated           Int?
  candidatesSelected            Int?
  prunedCount                   Int?
  verificationApplied           Boolean              @default(true)
  averageCandidateScore         Float?
  averageVerificationConfidence Float?
  selectedCandidates            Json?
  metadata                      Json?
  createdAt                     DateTime             @default(now())
  candidates                    ReasoningCandidate[]
  deck                          Deck?                @relation(fields: [deckId], references: [id], onDelete: Cascade)
  user                          User?                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([deckId, createdAt])
  @@index([mode, createdAt])
}

model ReasoningCandidate {
  id                     String       @id @default(cuid())
  runId                  String
  rank                   Int
  question               String
  answer                 String
  score                  Float
  verificationConfidence Float?
  selected               Boolean      @default(false)
  pruned                 Boolean      @default(false)
  trajectoryDepth        Int          @default(0)
  sourceAttempt          Int?
  difficulty             String?
  createdAt              DateTime     @default(now())
  run                    ReasoningRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, rank])
  @@index([runId, selected])
}

model StudentState {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  weakConcepts              Json?
  misconceptionPatterns     Json?
  confidenceProfile         Json?
  retentionProfile          Json?
  pacingProfile             Json?
  preferredExplanationStyle String?
  recentFailures            Json?
  recentSuccesses           Json?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
